---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionLink from "../../components/ActionLink.astro";

// Import screenshots
import homeImg from "../../assets/images/runway/home.png";
import clientImg from "../../assets/images/runway/client.png";
import clientDetailsImg from "../../assets/images/runway/client_details.png";
import projectImg from "../../assets/images/runway/project.png";
import projectDetailsImg from "../../assets/images/runway/project_details.png";
import invoiceImg from "../../assets/images/runway/invoice.png";

const features = [
  { img: homeImg, title: "Business Overview", desc: "See revenue, pending invoices, and active projects instantly." },
  { img: clientImg, title: "Client Directory", desc: "Quickly access and organize all your client profiles in one view." },
  { img: clientDetailsImg, title: "Client CRM", desc: "Keep contact info and associated projects together in one profile." },
  { img: projectImg, title: "Project Tracking", desc: "Monitor projects across pitching, production, and archived stages." },
  { img: projectDetailsImg, title: "Project Financials", desc: "Track total budget, payment progress, and related invoices." },
  { img: invoiceImg, title: "Invoice Tracking", desc: "Keep paid and pending invoices in one place for clear visibility." }
];
---

<BaseLayout pageTitle="Runway Case Study — Biplab Mahanty" description="How Biplab Mahanty designed and developed Runway, an Android CRM connecting clients, projects, estimates, and invoices.">
  <article class="work-page">
    <!-- Hero Section -->
    <header class="max-w-6xl mx-auto px-5 pt-8 sm:pt-12 lg:pt-12 pb-16 sm:pb-24">
      <div class="mb-6">
        <a href="/work/" class="text-sm font-mono uppercase tracking-widest text-slight-gray hover:text-nav transition-colors">&larr; Back to Work</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-start relative">
        
        <!-- 1. Intro (Top Left on Desktop, Top on Mobile) -->
        <div class="md:col-span-7 order-1">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground leading-[1.1] tracking-tight mb-6" style="font-family:'Recursive',monospace;">
            Runway
          </h1>
          <p class="text-lg sm:text-xl text-slight-gray leading-relaxed max-w-2xl">
            A client-management Android app built for independent workers. It organizes projects, estimates, and client details in one clear, structured dashboard.
          </p>
          <p class="mt-5 max-w-2xl text-sm leading-6 text-slight-gray sm:text-base sm:leading-7">
            Runway is a self-initiated product, shaped from my assumptions about how independent professionals manage client work rather than from a commissioned client brief.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-6 sm:gap-8 font-mono uppercase tracking-[0.16em] text-[10px] sm:text-xs">
            <div class="flex items-center gap-2 text-slight-gray">
              <svg class="w-3.5 h-3.5 md:w-4 md:h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
              <span>Internal Tool</span>
            </div>
            <div class="flex items-center gap-2 text-nav">
              <svg class="w-3.5 h-3.5 md:w-4 md:h-4 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.022 3.503c-1.4362-.6581-3.1371-1.025-4.965-1.025-1.828 0-3.529.3669-4.965 1.025l-2.022-3.503a.416.416 0 00-.5676-.1521.416.416 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"></path>
              </svg>
              <span>Android App</span>
            </div>
          </div>
        </div>

        <!-- 2. Vertical Video Demo (Right on Desktop, Middle on Mobile) -->
        <div class="md:col-span-5 md:row-span-2 flex justify-center md:justify-end md:sticky md:top-8 order-2 w-full relative">
          
          <!-- Glowing Pedestal -->
          <div class="pedestal-glow"></div>

          <div class="ambient-phone relative w-full max-w-[260px] md:max-w-[280px] lg:max-w-[300px] aspect-[9/19.5] mx-auto md:mx-0 md:-mt-4 bg-body/50 border border-border/90 rounded-[2rem] p-2 shadow-2xl overflow-hidden flex items-center justify-center">
            <button id="runway-video-btn" class="relative w-full h-full rounded-3xl overflow-hidden group focus:outline-none focus:ring-2 focus:ring-nav/50 cursor-pointer" aria-label="Pause Runway product demo">
              <video 
                id="runway-video"
                autoplay 
                loop 
                muted 
                playsinline 
                disablepictureinpicture
                poster={homeImg.src}
                class="w-full h-full object-cover rounded-3xl bg-black/20"
              >
                <source src="https://res.cloudinary.com/dtjmikv4t/video/upload/v1785579489/runway_demo_guzlrr.webm" type="video/webm">
                <source src="https://res.cloudinary.com/dtjmikv4t/video/upload/v1785579489/runway_demo_guzlrr.mp4" type="video/mp4">
              </video>
              
              <!-- Glassmorphic Play Overlay (Visible when paused) -->
              <div id="runway-video-overlay" class="absolute inset-0 bg-black/20 backdrop-blur-[2px] opacity-0 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
                <div class="w-16 h-16 rounded-full bg-body/90 border border-border/70 backdrop-blur-md flex items-center justify-center shadow-2xl transform transition-transform duration-300 scale-90 group-hover:scale-100">
                  <svg class="w-7 h-7 text-foreground ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </button>
          </div>
        </div>

        <!-- 3. The Problem (Bottom Left on Desktop, Bottom on Mobile) -->
        <div data-reveal class="ambient-divider md:col-span-7 order-3 border-t border-border/70 pt-12" style="--drift-delay: -2s;">
          <h2 class="text-2xl font-bold text-foreground mb-4" style="font-family:'Recursive',monospace;">The Problem</h2>
          <p class="text-slight-gray leading-relaxed mb-4">
            Independent workers and freelancers often manage their clients across a chaotic mix of emails, paper notes, text messages, and messy spreadsheets.
          </p>
          <p class="text-slight-gray leading-relaxed">
            When information is scattered, projects get delayed, invoices are forgotten, and important client details slip through the cracks. The goal was to create a single, focused place for managing business operations from a phone.
          </p>
        </div>

      </div>
    </header>

    <!-- Case Study Details -->
    <section class="ambient-divider max-w-6xl mx-auto px-5 py-20 border-t border-border/70 flex flex-col gap-12" style="--drift-delay: -5s;">
      
      <!-- The Story -->
      <div data-reveal class="max-w-3xl">
        <h2 class="text-2xl font-bold text-foreground mb-4" style="font-family:'Recursive',monospace;">The Solution</h2>
        <p class="text-slight-gray leading-relaxed text-lg">
          I designed and developed Runway, a clean, distraction-free CRM app for Android. It brings clients, projects, estimates, and invoices together in one organized workspace.
        </p>
      </div>

      <!-- Meta Info -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-6 border border-border rounded-3xl bg-menu/30" data-reveal>
          <h3 class="text-xs font-mono uppercase tracking-[0.16em] text-nav mb-4">My Role</h3>
          <ul class="flex flex-col gap-3 text-sm text-slight-gray">
            <li class="flex items-center gap-2"><span class="text-nav">&rarr;</span> UI/UX Design</li>
            <li class="flex items-center gap-2"><span class="text-nav">&rarr;</span> Android Development</li>
            <li class="flex items-center gap-2"><span class="text-nav">&rarr;</span> Database Architecture</li>
            <li class="flex items-center gap-2"><span class="text-nav">&rarr;</span> Product Strategy</li>
          </ul>
        </div>

        <div class="p-6 border border-border rounded-3xl bg-menu/30 flex flex-col justify-center" data-reveal>
          <h3 class="text-xs font-mono uppercase tracking-[0.16em] text-nav mb-4">Designed Outcome</h3>
          <p class="text-sm text-slight-gray leading-relaxed">
            Runway is designed to reduce the number of places an independent professional has to check by keeping client details, projects, estimates, invoices, and documents in one mobile workspace. This is the intended outcome, not a measured client result.
          </p>
        </div>
      </div>
    </section>

    <!-- Infinite Image Slider -->
    <section class="-mx-4 sm:-mx-8 md:-mx-16 pb-16 sm:pb-24 pt-8 overflow-hidden relative" data-reveal>
      <div class="mx-auto max-w-6xl px-9 sm:px-16 md:px-21">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-nav">Interface overview</p>
        <h2 class="mt-3 font-[Recursive] text-2xl font-bold text-foreground sm:text-3xl">The working product, from overview to invoice.</h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slight-gray">A continuous view of the main screens. Pause the movement by hovering, focusing, or pressing anywhere on the strip.</p>
      </div>
      <div class="marquee-wrapper group flex cursor-ew-resize overflow-hidden py-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-nav/60" tabindex="0" role="region" aria-label="Runway application screen gallery">
        <!-- Original Track -->
        <div class="marquee-track flex gap-16 sm:gap-24 md:gap-32 shrink-0 pr-16 sm:pr-24 md:pr-32 items-center">
          {features.map((feat, index) => (
            <div class="shrink-0 flex items-center justify-center">
              <div 
                class="h-[280px] sm:h-[350px] md:h-[400px]"
                style={`animation: float-zen 8s ease-in-out infinite alternate; animation-delay: ${index * -1.2}s;`}
              >
                <Image 
                  src={feat.img} 
                  alt={feat.title}
                  class="h-full w-auto object-contain transform transition-all duration-700 hover:scale-[1.04] hover:brightness-110 cursor-pointer"
                  loading="lazy"
                />
              </div>
            </div>
          ))}
        </div>
        
        <!-- Duplicate Track for Seamless Loop -->
        <div class="marquee-track flex gap-16 sm:gap-24 md:gap-32 shrink-0 pr-16 sm:pr-24 md:pr-32 items-center" aria-hidden="true">
          {features.map((feat, index) => (
            <div class="shrink-0 flex items-center justify-center">
              <div 
                class="h-[280px] sm:h-[350px] md:h-[400px]"
                style={`animation: float-zen 8s ease-in-out infinite alternate; animation-delay: ${index * -1.2}s;`}
              >
                <Image 
                  src={feat.img} 
                  alt={feat.title}
                  class="h-full w-auto object-contain transform transition-all duration-700 hover:scale-[1.04] hover:brightness-110 cursor-pointer"
                  loading="lazy"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Key Product Decisions -->
    <section class="max-w-5xl mx-auto px-5 py-20 sm:py-24" data-reveal>
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-foreground mb-4" style="font-family:'Recursive',monospace;">Key Product Decisions</h2>
        <p class="text-slight-gray text-lg max-w-2xl leading-relaxed">
          I structured Runway around the relationships that shape independent client work, keeping contacts, projects, estimates, and invoices connected without duplicating information.
        </p>
      </div>

      <div class="flex flex-col gap-24 sm:gap-32 mt-16">
        
        <!-- Feature 1: Left Image, Right Text -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
          <div class="order-2 md:order-1 relative p-6 flex justify-center">
            <Image src={homeImg} alt="Runway dashboard showing monthly revenue, pending invoices, and active projects" class="h-auto w-full max-w-[240px] object-contain drop-shadow-2xl sm:max-w-[260px] md:max-w-[280px] lg:max-w-[320px]" loading="lazy" />
          </div>
          <div class="order-1 md:order-2 flex flex-col gap-6" data-reveal>
            <div class="ambient-divider-b flex items-center gap-4 border-b border-border/70 pb-4" style="--drift-delay: -1s;">
              <span class="text-xs font-mono bg-body/50 text-emerald-400/80 px-2 py-1 rounded">01</span>
              <h3 class="font-bold text-2xl text-foreground tracking-wide">Priorities at a Glance</h3>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Goal</h4>
              <p class="text-slight-gray leading-relaxed">Make active work and payment status visible without requiring someone to open several separate screens.</p>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Execution</h4>
              <p class="text-slight-gray leading-relaxed">The dashboard surfaces monthly revenue, pending invoices, and active projects together, with project-stage filters available directly from the overview.</p>
            </div>
          </div>
        </div>

        <!-- Feature 2: Left Text, Right Image -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
          <div class="order-1 flex flex-col gap-6" data-reveal>
            <div class="ambient-divider-b flex items-center gap-4 border-b border-border/70 pb-4" style="--drift-delay: -4s;">
              <span class="text-xs font-mono bg-body/50 text-emerald-400/80 px-2 py-1 rounded">02</span>
              <h3 class="font-bold text-2xl text-foreground tracking-wide">One Relationship, Connected Work</h3>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Goal</h4>
              <p class="text-slight-gray leading-relaxed">Avoid duplicating a contact as the relationship moves from a prospective lead to active client work.</p>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Execution</h4>
              <p class="text-slight-gray leading-relaxed">A contact begins as a lead and becomes an active client when their first project is created. The same profile keeps their contact information and related projects together.</p>
            </div>
          </div>
          <div class="order-2 relative p-6 flex justify-center">
            <Image src={clientDetailsImg} alt="Runway client profile showing contact information and related projects" class="h-auto w-full max-w-[240px] object-contain drop-shadow-2xl sm:max-w-[260px] md:max-w-[280px] lg:max-w-[320px]" loading="lazy" />
          </div>
        </div>

        <!-- Feature 3: Left Image, Right Text -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
          <div class="order-2 md:order-1 relative p-6 flex justify-center">
            <Image src={projectDetailsImg} alt="Runway project view showing total budget, payment progress, and related invoices" class="h-auto w-full max-w-[240px] object-contain drop-shadow-2xl sm:max-w-[260px] md:max-w-[280px] lg:max-w-[320px]" loading="lazy" />
          </div>
          <div class="order-1 md:order-2 flex flex-col gap-6" data-reveal>
            <div class="ambient-divider-b flex items-center gap-4 border-b border-border/70 pb-4" style="--drift-delay: -7s;">
              <span class="text-xs font-mono bg-body/50 text-emerald-400/80 px-2 py-1 rounded">03</span>
              <h3 class="font-bold text-2xl text-foreground tracking-wide">Project-Centered Billing</h3>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Goal</h4>
              <p class="text-slight-gray leading-relaxed">Keep estimates and invoices connected to the work they describe instead of treating them as unrelated financial records.</p>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-sm font-semibold text-foreground/80">The Execution</h4>
              <p class="text-slight-gray leading-relaxed">Every estimate and invoice belongs to a project, while invoices are created separately rather than generated from estimates. Pending invoices automatically become overdue after their due date passes, and the project view summarizes its total budget and payment progress.</p>
            </div>
          </div>
        </div>
        
      </div>
    </section>

    <!-- Call to Action -->
    <section class="ambient-divider max-w-6xl mx-auto px-5 py-14 sm:py-16 border-t border-border/70" style="--drift-delay: -3s;">
      <div data-reveal>
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-bold text-foreground mb-6 text-balance" style="font-family:'Recursive',monospace;">Need a custom tool built around your business?</h2>
          <p class="text-slight-gray leading-relaxed mb-4 text-pretty">
            Building Runway taught me how to listen to a workflow and turn its friction into focused software. That same thinking applies to any business.
          </p>
          <p class="text-slight-gray leading-relaxed mb-8 text-pretty">
            If off-the-shelf tools aren't fitting the way you actually work, I can build something that does.
          </p>
          <div class="flex justify-center">
            <ActionLink href="/contact/">Let's discuss your project</ActionLink>
          </div>
        </div>
      </div>
    </section>
  </article>
<style>
  @keyframes float-zen {
    0% {
      transform: translateY(6px) rotate(-1.5deg);
    }
    100% {
      transform: translateY(-14px) rotate(1.5deg);
    }
  }
</style>

<script>
  function setupCustomVideoPlayer() {
    const btn = document.getElementById('runway-video-btn');
    const video = document.getElementById('runway-video') as HTMLVideoElement;
    const overlay = document.getElementById('runway-video-overlay');

    if (btn && video && overlay) {
      btn.onclick = () => {
        if (video.paused) {
          void video.play();
          btn.setAttribute('aria-label', 'Pause Runway product demo');
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
        } else {
          video.pause();
          btn.setAttribute('aria-label', 'Play Runway product demo');
          overlay.classList.remove('opacity-0');
          overlay.classList.add('opacity-100');
        }
      };
    }

    const gallery = document.querySelector('.marquee-wrapper');
    if (gallery instanceof HTMLElement && !gallery.dataset.pauseReady) {
      gallery.dataset.pauseReady = 'true';
      const toggleGallery = () => {
        const isPaused = gallery.classList.toggle('is-paused');
        gallery.setAttribute('aria-label', `${isPaused ? 'Paused' : 'Moving'} Runway application screen gallery`);
      };
      gallery.addEventListener('click', toggleGallery);
      gallery.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        toggleGallery();
      });
    }
  }

  // Run on initial load and handle Astro view transitions
  setupCustomVideoPlayer();
  document.addEventListener('astro:page-load', setupCustomVideoPlayer);
</script>

<style>
  .ambient-divider {
    position: relative;
  }
  
  .ambient-divider::before,
  .ambient-divider.border-y::after,
  .ambient-divider-b::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      color-mix(in srgb, var(--color-nav) 15%, transparent) 35%, 
      color-mix(in srgb, var(--color-nav) 70%, transparent) 50%, 
      color-mix(in srgb, var(--color-nav) 15%, transparent) 65%, 
      transparent 100%
    );
    background-size: 200% 100%;
    opacity: 0.8;
    pointer-events: none;
    animation: ambient-pan 12s ease-in-out var(--drift-delay, 0s) infinite alternate;
  }

  .ambient-divider::before {
    top: -1px;
  }

  .ambient-divider.border-y::after {
    bottom: -1px;
    animation-direction: alternate-reverse;
  }

  .ambient-divider-b {
    position: relative;
  }
  .ambient-divider-b::after {
    bottom: -1px;
  }

  @keyframes ambient-pan {
    0% { background-position: 100% 0; opacity: 0.2; }
    50% { opacity: 0.7; }
    100% { background-position: 0% 0; opacity: 0.2; }
  }

  /* Glowing Pedestal Background */
  .pedestal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    max-width: 500px;
    height: 80%;
    background: radial-gradient(circle, var(--color-nav) 0%, transparent 70%);
    opacity: 0.15;
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
    animation: pulse-glow 6s ease-in-out infinite alternate;
  }

  @keyframes pulse-glow {
    0% { transform: translate(-50%, -50%) scale(0.85); opacity: 0.1; }
    100% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.25; }
  }

  /* Glowing Phone Bezel (Border Tracing Effect) */
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  /* Infinite Marquee Slider */
  .marquee-track {
    animation: scroll-x 40s linear infinite;
  }
  
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-wrapper:focus-within .marquee-track,
  .marquee-wrapper.is-paused .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scroll-x {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .ambient-phone {
    position: relative;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  }
  
  .ambient-phone::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2rem;
    padding: 1.5px; /* Thickness of the running glow */
    background: conic-gradient(from var(--angle), transparent 60%, var(--color-nav) 80%, transparent 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotate-glow 4s linear infinite;
    pointer-events: none;
    z-index: 10;
  }

  @keyframes rotate-glow {
    from { --angle: 0deg; }
    to { --angle: 360deg; }
  }

  .work-motion [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-motion [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .pedestal-glow,
    .ambient-phone::after {
      animation-play-state: paused;
    }

    .work-motion [data-reveal] {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  function initCaseStudyMotion() {
    const page = document.querySelector('.work-page');
    if (!page) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    if (!page.classList.contains('work-motion')) {
      page.classList.add('work-motion');
      
      const elements = page.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
      elements.forEach((element) => observer.observe(element));
    }
  }

  initCaseStudyMotion();
  document.addEventListener('astro:after-swap', initCaseStudyMotion);
</script>
