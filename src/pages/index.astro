---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import ArticleList from "../components/ArticleList.astro";
import ActionLink from "../components/ActionLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ensoGraphic from "../assets/enso_feature_graphic.png";
import runwayGraphic from "../assets/images/runway/runway_graphic.jpg";

const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
const systemsTags = tags.filter((tag) => tag !== "life");
const inquiryTags = tags.filter((tag) => tag === "life");
const pageTitle = "Biplab Mahanty — Software Developer and Product Builder";
const description = "Biplab Mahanty builds Android apps, websites, and custom business tools, including EnsoMori and Runway.";
---

<BaseLayout pageTitle={pageTitle} description={description} showHero={true}>
  <section class="ambient-divider mx-auto max-w-6xl border-t border-border/50 py-16 sm:py-24" aria-labelledby="selected-work-title">
    <div class="mb-8 max-w-2xl sm:mb-10" data-page-reveal>
      <p class="section-label">Selected work</p>
      <h2 id="selected-work-title" class="section-heading">Products shaped from questions worth exploring.</h2>
      <p class="section-copy">Self-initiated projects showing how I think about workflows, product decisions, and difficult human problems.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2" data-page-reveal style="--reveal-delay: 80ms;">
      <a href="https://ensomori.com" target="_blank" rel="noopener noreferrer" class="project-card group">
        <div class="project-visual bg-menu/70">
          <Image src={ensoGraphic} alt="EnsoMori brush circle artwork" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
        </div>
        <div class="p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-primary">Independent experiment</p>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </div>
          <h3 class="mt-3 font-[Recursive] text-xl font-semibold text-foreground sm:text-2xl">EnsoMori</h3>
          <p class="mt-2 text-sm leading-6 text-slight-gray sm:text-[15px]">An experiment in deep self-inquiry, asking whether technology can create an opening to observe ourselves without becoming another method to follow.</p>
        </div>
      </a>

      <a href="/work/runway/" class="project-card group">
        <div class="project-visual bg-[#07110d]">
          <Image src={runwayGraphic} alt="Runway customer management app screens" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
        </div>
        <div class="p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-primary">Independent product</p>
            <span class="project-arrow" aria-hidden="true">→</span>
          </div>
          <h3 class="mt-3 font-[Recursive] text-xl font-semibold text-foreground sm:text-2xl">Runway</h3>
          <p class="mt-2 text-sm leading-6 text-slight-gray sm:text-[15px]">A focused Android CRM that connects clients, projects, estimates, and invoices for independent professionals.</p>
        </div>
      </a>
    </div>
    <a href="/work/" class="group mt-7 inline-flex min-h-10 items-center gap-1.5 text-sm font-semibold text-foreground transition-colors hover:text-primary" data-page-reveal style="--reveal-delay: 120ms;">
      <span>See how I approach product work</span>
      <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
    </a>
  </section>

  <section class="ambient-divider mx-auto max-w-6xl border-t border-border/50 py-16 sm:py-24" aria-labelledby="services-title">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-page-reveal>
        <p class="section-label">What I build</p>
        <h2 id="services-title" class="section-heading">Useful software, with the problem kept in view.</h2>
        <p class="section-copy">I work with independent businesses and professionals who need software fitted to the way their work actually happens.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3" data-page-reveal style="--reveal-delay: 80ms;">
        {[
          ["01", "Android apps", "Focused mobile products designed around a clear workflow."],
          ["02", "Websites", "Fast, responsive sites that explain the work and guide the next action."],
          ["03", "Custom tools", "Internal software that replaces scattered, repetitive processes."],
        ].map(([number, title, copy]) => (
          <article class="rounded-3xl border border-border bg-menu/40 p-5 sm:p-6">
            <span class="font-mono text-[10px] tracking-[0.16em] text-primary">{number}</span>
            <h3 class="mt-5 font-[Recursive] text-lg font-semibold text-foreground">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-slight-gray">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="posts" class="ambient-divider mx-auto max-w-6xl scroll-mt-24 border-t border-border/50 py-16 sm:py-24" aria-labelledby="writing-title">
    <div class="mb-8 max-w-2xl sm:mb-10" data-page-reveal>
      <p class="section-label">Writings</p>
      <h2 id="writing-title" class="section-heading">Following systems inward and outward.</h2>
      <p class="section-copy">Technical deep dives sit beside questions about attention, change, and understanding ourselves.</p>
    </div>
    <div class="grid gap-10 md:grid-cols-[1.45fr_0.55fr] md:gap-12" data-page-reveal style="--reveal-delay: 80ms;">
      <ArticleList />
      <aside class="space-y-7 md:border-l md:border-border/50 md:pl-8" aria-label="Writing topics">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-foreground">Systems</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {systemsTags.map((tag) => <a href={`/tags/${tag}`} class="topic-pill">{tag}</a>)}
          </div>
        </div>
        {inquiryTags.length > 0 && (
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-foreground">Self-inquiry</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {inquiryTags.map((tag) => <a href={`/tags/${tag}`} class="topic-pill">{tag}</a>)}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="ambient-divider mx-auto max-w-6xl border-t border-border/50 py-16 sm:py-24" aria-labelledby="about-teaser-title">
    <div class="grid items-end gap-7 md:grid-cols-[1fr_auto] md:gap-12" data-page-reveal>
      <div class="max-w-3xl">
        <p class="section-label">About</p>
        <h2 id="about-teaser-title" class="section-heading">I begin with the workflow, the friction, and the decisions the software needs to support.</h2>
        <p class="section-copy">That has led me from low-level systems to business workflows and, through EnsoMori, to questions about whether a tool can support inquiry without replacing it.</p>
      </div>
      <ActionLink href="/about/" variant="secondary">More about me</ActionLink>
    </div>
  </section>

  <section class="ambient-divider mx-auto max-w-6xl border-y border-border/50 py-16 text-center sm:py-24" aria-labelledby="contact-title" data-page-reveal>
    <p class="section-label justify-center">Start a conversation</p>
    <h2 id="contact-title" class="mx-auto max-w-3xl font-[Recursive] text-3xl font-bold leading-tight text-foreground sm:text-4xl lg:text-5xl">Have a real workflow that needs a thoughtful tool?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-slight-gray sm:text-base sm:leading-7">Tell me what is difficult, repetitive, or scattered. We can first decide whether custom software is the right answer.</p>
    <div class="mt-7 flex justify-center"><ActionLink href="/contact/">Discuss your project</ActionLink></div>
  </section>
</BaseLayout>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-heading {
    color: var(--color-foreground);
    font-family: "Recursive", sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .section-copy {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--color-slight-gray);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .project-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--color-menu) 35%, transparent);
    transition: border-color 300ms ease, box-shadow 300ms ease, transform 300ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: color-mix(in srgb, var(--color-nav) 60%, transparent);
    box-shadow: 0 22px 60px -38px var(--color-primary);
    transform: translateY(-3px);
  }

  .project-visual {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .project-arrow {
    display: flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-slight-gray);
    font-size: 0.875rem;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .project-card:hover .project-arrow,
  .project-card:focus-visible .project-arrow {
    border-color: color-mix(in srgb, var(--color-nav) 60%, transparent);
    color: var(--color-primary);
  }

  .topic-pill {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    color: var(--color-slight-gray);
    font-size: 0.6875rem;
    font-weight: 500;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .topic-pill:hover,
  .topic-pill:focus-visible {
    border-color: color-mix(in srgb, var(--color-nav) 60%, transparent);
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .section-heading { font-size: 1.875rem; }
    .section-copy { font-size: 1rem; line-height: 1.75rem; }
  }

  @media (min-width: 1024px) {
    .section-heading { font-size: 2.25rem; }
  }
</style>
