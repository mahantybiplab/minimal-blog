---

<button id="themeToggle" type="button" aria-label="Toggle color theme" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border text-slight-gray transition-colors hover:border-nav/50 hover:text-foreground">
  <svg
    aria-hidden="true"
    width="20px"
    height="20px"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="fill-current"
  >
    <path
      class="sun"
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0-1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
    <path
      class="moon"
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
  </svg>
</button>

<style>
  svg {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sun, .moon {
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: 50% 50%;
    transform-box: fill-box;
    fill: currentColor;
  }

  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  :global(.dark) svg {
    transform: rotate(360deg);
  }

  :global(.dark) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global(.dark) .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
    mix-blend-mode: normal !important;
    display: block !important;
    opacity: 1 !important;
  }

  :global(.theme-going-dark)::view-transition-old(root) {
    z-index: 1 !important;
  }
  :global(.theme-going-dark)::view-transition-new(root) {
    z-index: 2 !important;
    animation: clip-expand 0.4s ease-out forwards !important;
  }

  :global(.theme-going-light)::view-transition-old(root) {
    z-index: 2 !important;
    animation: clip-shrink 0.4s ease-out forwards !important;
  }
  :global(.theme-going-light)::view-transition-new(root) {
    z-index: 1 !important;
  }

  @keyframes clip-expand {
    0% { clip-path: circle(0px at var(--click-x, 50%) var(--click-y, 50%)); }
    100% { clip-path: circle(150vw at var(--click-x, 50%) var(--click-y, 50%)); }
  }

  @keyframes clip-shrink {
    0% { clip-path: circle(150vw at var(--click-x, 50%) var(--click-y, 50%)); }
    100% { clip-path: circle(0px at var(--click-x, 50%) var(--click-y, 50%)); }
  }
  /* Smooth ultra-fast fallback for mobile */
  :global(.theme-mobile-fade),
  :global(.theme-mobile-fade) *,
  :global(.theme-mobile-fade) *::before,
  :global(.theme-mobile-fade) *::after {
    transition: background-color 0.3s ease-out, color 0.3s ease-out, border-color 0.3s ease-out, fill 0.3s ease-out, stroke 0.3s ease-out !important;
  }

  /* Prevent CSS transitions from ruining View Transition screenshots */
  :global(.theme-is-switching) * {
    transition: none !important;
  }
</style>

<script is:inline>
  function attachToggleListener() {
    const toggle = document.getElementById("themeToggle");

    const handleToggleClick = (e) => {
      const element = document.documentElement;
      const isGoingDark = !element.classList.contains("dark");

      // Store exact click position for CSS keyframes
      element.style.setProperty("--click-x", (e.clientX ?? innerWidth / 2) + "px");
      element.style.setProperty("--click-y", (e.clientY ?? innerHeight / 2) + "px");

      const toggleTheme = () => {
        element.classList.toggle("dark");
        localStorage.setItem("theme", isGoingDark ? "dark" : "light");
      };

      // MOBILE FIX: Bypass View Transitions entirely.
      const isMobile = window.matchMedia("(max-width: 1024px)").matches;

      if (isMobile || !document.startViewTransition) {
        element.classList.add("theme-mobile-fade");

        // Force the browser to register the transition class BEFORE toggling the theme
        void element.offsetHeight;

        toggleTheme();

        setTimeout(() => element.classList.remove("theme-mobile-fade"), 400);
        return;
      }

      // Add the animation classes before transitioning
      element.classList.add(isGoingDark ? "theme-going-dark" : "theme-going-light");

      // Force disable all CSS transitions so the view transition snapshot is instantly accurate
      element.classList.add("theme-is-switching");

      const transition = document.startViewTransition(() => {
        toggleTheme();
      });

      transition.finished.then(() => {
        element.classList.remove("theme-going-dark", "theme-going-light", "theme-is-switching");
      });
    };

    if (toggle) {
      toggle.addEventListener("click", handleToggleClick);
    }
  }

  // Initialize on page load
  attachToggleListener();

  // Re-initialize after Astro page swaps (for View Transitions)
  document.addEventListener("astro:after-swap", attachToggleListener);
</script>
