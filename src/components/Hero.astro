---
import ActionLink from "./ActionLink.astro";
---

<section id="hero" class="relative mx-auto flex min-h-[72vh] w-full max-w-6xl -translate-y-3 items-center px-1 pb-12 pt-20 sm:min-h-[76vh] sm:-translate-y-4 sm:px-0 sm:pb-16 sm:pt-24 lg:min-h-[78vh]">
  <div class="w-full max-w-4xl">
    <div>
      <a href="https://ensomori.com" target="_blank" rel="noopener noreferrer" class="reveal group mb-5 inline-flex min-h-8 items-center gap-2.5 rounded-full border border-border bg-body/55 px-3.5 py-1.5 backdrop-blur-sm transition-colors hover:border-nav/60 sm:mb-7">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-nav opacity-50 [animation-duration:3s]"></span>
          <span class="relative inline-flex h-full w-full rounded-full bg-nav"></span>
        </span>
        <span class="font-mono text-[9px] font-medium uppercase tracking-[0.16em] text-slight-gray group-hover:text-foreground sm:text-[10px]">Currently exploring · EnsoMori</span>
      </a>

      <h1 class="work-headline reveal max-w-3xl font-[Recursive] text-[2rem] font-bold leading-[1.05] tracking-[-0.035em] text-foreground sm:text-4xl md:text-5xl lg:text-[3.35rem]" style="--delay: 80ms;">
        <span class="headline-context">I build</span>
        <span class="headline-static">software</span>
        <span class="headline-context">for real work and deeper inquiry.</span>
      </h1>

      <p class="reveal mt-6 max-w-2xl text-[15px] leading-7 text-slight-gray sm:text-[17px] sm:leading-8" style="--delay: 160ms;">
        I’m Biplab, a software developer building Android apps, websites, and custom business tools. I also write about how systems work and what it means to understand ourselves.
      </p>

      <div class="reveal mt-7 flex flex-wrap items-center gap-3 sm:mt-9" style="--delay: 240ms;">
        <ActionLink href="/work/">View selected work</ActionLink>
        <ActionLink href="/contact/" variant="secondary">Discuss a project</ActionLink>
        <a href="#posts" class="group inline-flex min-h-10 items-center gap-1.5 px-2 text-xs font-semibold text-slight-gray transition-colors hover:text-foreground sm:text-[13px]">
          <span>Explore my writing</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-reveal 800ms var(--delay, 0ms) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hero-reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  .headline-context {
    will-change: transform;
  }

  .headline-rotator {
    color: var(--color-nav);
    margin-top: -0.05em;
    margin-bottom: -0.05em;
  }

  .headline-track-item {
    will-change: transform, opacity;
  }

  .headline-static {
    display: none;
    color: var(--color-nav);
  }

  @keyframes slot-fade-1 {
    0%, 28% { opacity: 1; transform: translateY(0); pointer-events: auto; }
    33% { opacity: 0; transform: translateY(-1em); pointer-events: none; }
    34%, 95% { opacity: 0; transform: translateY(1em); pointer-events: none; }
    100% { opacity: 1; transform: translateY(0); pointer-events: auto; }
  }

  @keyframes slot-fade-2 {
    0%, 28% { opacity: 0; transform: translateY(1em); pointer-events: none; }
    33%, 61% { opacity: 1; transform: translateY(0); pointer-events: auto; }
    66% { opacity: 0; transform: translateY(-1em); pointer-events: none; }
    67%, 100% { opacity: 0; transform: translateY(1em); pointer-events: none; }
  }

  @keyframes slot-fade-3 {
    0%, 61% { opacity: 0; transform: translateY(1em); pointer-events: none; }
    66%, 94% { opacity: 1; transform: translateY(0); pointer-events: auto; }
    100% { opacity: 0; transform: translateY(-1em); pointer-events: none; }
  }
</style>
