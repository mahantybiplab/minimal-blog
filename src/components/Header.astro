---
import Logo from "./Logo.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { Icon } from "astro-icon/components";

const navigation = [
  { href: "/", label: "Home" },
  { href: "/work/", label: "Work" },
  { href: "/#posts", label: "Writings" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="fixed left-1/2 top-3 z-50 w-[calc(100%-1.5rem)] max-w-2xl -translate-x-1/2 sm:top-4 sm:w-[calc(100%-2rem)]">
  <div class="flex h-12 items-center justify-between rounded-full border border-border bg-navbar px-3 shadow-[0_8px_32px_-12px_rgba(0,0,0,0.22)] backdrop-blur-2xl sm:px-5">
    <Logo />
    <div class="flex items-center gap-1.5 sm:gap-2">
      <nav class="mr-2 hidden items-center gap-4 md:flex" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href} class="text-sm font-medium text-slight-gray transition-colors hover:text-foreground focus-visible:text-foreground">
            {item.label}
          </a>
        ))}
        <a href="https://github.com/mahantybiplab/" target="_blank" rel="noopener noreferrer" class="text-slight-gray transition-colors hover:text-foreground" aria-label="Biplab Mahanty on GitHub"><Icon name="mdi:github" size={20} /></a>
        <a href="https://x.com/MahantyBiplab3" target="_blank" rel="noopener noreferrer" class="text-slight-gray transition-colors hover:text-foreground" aria-label="Biplab Mahanty on X"><Icon name="x" size={16} /></a>
      </nav>
      <ThemeIcon />
      <button
        id="hamburger-btn"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-overlay"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border text-slight-gray transition-colors hover:border-nav/50 hover:text-foreground focus-visible:text-foreground md:hidden"
      >
        <svg id="hamburger-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="hamburger-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 md:hidden" aria-hidden="true" inert>
  <button id="overlay-backdrop" type="button" aria-label="Close navigation menu" class="absolute inset-0 bg-body/85 opacity-0 backdrop-blur-md transition-opacity duration-300"></button>
  <div id="overlay-panel" class="absolute left-3 right-3 top-[4.5rem] -translate-y-2 overflow-hidden rounded-[1.5rem] border border-border bg-menu p-2 opacity-0 shadow-[0_24px_70px_-20px_rgba(0,0,0,0.45)] transition-[opacity,transform] duration-300 ease-out sm:left-4 sm:right-4 sm:top-20">
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {navigation.map((item) => (
        <a href={item.href} class="group flex min-h-12 items-center rounded-full border border-transparent px-4 text-foreground transition-colors hover:border-border hover:bg-card-hover focus-visible:border-nav/60 focus-visible:bg-card-hover">
          <span class="text-[15px] font-medium">{item.label}</span>
          <svg class="ml-auto h-4 w-4 text-slight-gray transition-transform group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h8M7 3l3 3-3 3" /></svg>
        </a>
      ))}
      <div class="mx-4 my-1 h-px bg-border"></div>
      <div class="flex min-h-12 items-center gap-5 px-4">
        <a href="https://github.com/mahantybiplab/" target="_blank" rel="noopener noreferrer" aria-label="Biplab Mahanty on GitHub" class="text-slight-gray transition-colors hover:text-foreground"><Icon name="mdi:github" size={22} /></a>
        <a href="https://x.com/MahantyBiplab3" target="_blank" rel="noopener noreferrer" aria-label="Biplab Mahanty on X" class="text-slight-gray transition-colors hover:text-foreground"><Icon name="x" size={18} /></a>
      </div>
    </nav>
  </div>
</div>

<script is:inline>
  function initMenu() {
    const btn = document.getElementById("hamburger-btn");
    const overlay = document.getElementById("mobile-overlay");
    const backdrop = document.getElementById("overlay-backdrop");
    const panel = document.getElementById("overlay-panel");
    const iconOpen = document.getElementById("hamburger-open");
    const iconClose = document.getElementById("hamburger-close");
    if (!(btn instanceof HTMLButtonElement) || !(overlay instanceof HTMLElement) || !(backdrop instanceof HTMLButtonElement) || !(panel instanceof HTMLElement) || btn.dataset.menuReady) return;

    btn.dataset.menuReady = "true";
    let isOpen = false;

    const focusableElements = () => Array.from(panel.querySelectorAll("a[href], button:not([disabled])")).filter((element) => element instanceof HTMLElement);

    function openMenu() {
      isOpen = true;
      overlay.inert = false;
      overlay.classList.remove("pointer-events-none");
      overlay.setAttribute("aria-hidden", "false");
      btn.setAttribute("aria-expanded", "true");
      btn.setAttribute("aria-label", "Close navigation menu");
      backdrop.style.opacity = "1";
      panel.style.opacity = "1";
      panel.style.transform = "translateY(0)";
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeMenu(returnFocus = false) {
      if (!isOpen && !returnFocus) return;
      isOpen = false;
      overlay.inert = true;
      overlay.classList.add("pointer-events-none");
      overlay.setAttribute("aria-hidden", "true");
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-label", "Open navigation menu");
      backdrop.style.opacity = "0";
      panel.style.opacity = "0";
      panel.style.transform = "translateY(-8px)";
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      document.body.style.overflow = "";
      if (returnFocus) btn.focus();
    }

    btn.addEventListener("click", () => isOpen ? closeMenu() : openMenu());
    backdrop.addEventListener("click", () => closeMenu(true));
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => closeMenu()));
    document.addEventListener("keydown", (event) => {
      if (!isOpen) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = focusableElements();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        btn.focus();
      } else if (!event.shiftKey && document.activeElement === btn) {
        event.preventDefault();
        first.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        btn.focus();
      }
    });
    window.addEventListener("resize", () => { if (window.innerWidth >= 768) closeMenu(); });
  }

  initMenu();
  document.addEventListener("astro:after-swap", initMenu);
</script>
